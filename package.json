{
  "name": "phd-career",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run server:dev\" \"npm run web:dev\"",
    "web:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vue:dev": "vite --config vite.vue.config.ts",
    "vue:build": "vite build --config vite.vue.config.ts",
    "server:dev": "cd server && npx tsx watch src/index.ts",
    "server:build": "cd server && npx tsc",
    "server:start": "node server/dist/index.js",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx prisma db seed",
    "setup": "npm install && cd server && npm install && npx prisma migrate dev && npx prisma db seed"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "echarts": "^6.1.0",
    "lucide-react": "^0.441.0",
    "lucide-vue-next": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "vue": "^3.5.42",
    "vue-echarts": "^8.2.0",
    "vue-router": "^4.6.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vite": "^5.4.7"
  }
}
